{
  "appId": "com.maftuuh.solaibot",
  "appName": "SOL AI Bot",
  "webDir": "www",
  "server": { "androidScheme": "https" },
  "android": { "backgroundColor": "#0b0f19" },
  "plugins": {
    "CapacitorHttp": { "enabled": true },
    "SplashScreen": { "launchShowDuration": 0 },
    "LocalNotifications": { "smallIcon": "ic_stat_notify", "iconColor": "#9945FF" },
    "BackgroundRunner": {
      "label": "com.maftuuh.solaibot.check",
      "src": "runners/background.js",
      "event": "checkState",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
